{
  "schemaVersion": 1,
  "id": "community.elder-brain",
  "name": "Elder Brain",
  "version": "0.2.0",
  "author": "Bruno Mendes",
  "license": "MIT",
  "description": "Health and activity panel for a shared ai-memory server: latency, counts, connected machines and recent memory.",
  "kinds": ["bar-widget"],
  "activation": "on-demand",
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Elder Brain",
    "description": "Collective agent memory in the bar: server health, latency, connected machines and recent activity.",
    "category": "System",
    "aliases": ["elder brain", "memory", "collective memory", "ai-memory", "akita"],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 120
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 60,
        "max": 900,
        "step": 30,
        "defaultValue": 120
      }
    ]
  }
}
