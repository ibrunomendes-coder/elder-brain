# Elder Brain — configuração do servidor (copie para .env e preencha)

# Token Bearer que TODOS os clientes usarão. Gere com: openssl rand -hex 32
AI_MEMORY_AUTH_TOKEN=

# Chave do Gemini (consolidação + embeddings da memória)
GEMINI_API_KEY=

# IP da interface PRIVADA onde publicar (IP tailscale da VPS, IP de LAN...).
# 127.0.0.1 = só a própria máquina (útil pra teste local).
BIND_IP=127.0.0.1

# Hosts aceitos no header Host, separados por vírgula.
# Inclua o BIND_IP e qualquer hostname que os clientes usem.
ALLOWED_HOSTS=localhost,127.0.0.1,::1

# LLM (opcional — defaults gemini)
# LLM_PROVIDER=gemini
# EMBEDDING_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash
