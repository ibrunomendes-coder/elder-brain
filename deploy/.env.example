# Elder Brain server configuration — copy to .env and fill in locally.

# Container image. Evaluate `latest`, then pin a version or digest in production.
AI_MEMORY_IMAGE=akitaonrails/ai-memory:latest

# Master Bearer token shared by authorized clients.
# Generate one with: openssl rand -hex 32
AI_MEMORY_AUTH_TOKEN=

# Optional Gemini key for memory consolidation and embeddings.
GEMINI_API_KEY=

# PRIVATE interface address used to publish the service.
# Use a Tailscale/WireGuard/LAN address in production.
# 127.0.0.1 exposes the service only to the host and is suitable for local tests.
BIND_IP=127.0.0.1

# Comma-separated Host headers accepted by ai-memory.
# Include BIND_IP and every private hostname clients use.
ALLOWED_HOSTS=localhost,127.0.0.1,::1

# Optional LLM settings (Gemini defaults shown).
# LLM_PROVIDER=gemini
# EMBEDDING_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash
